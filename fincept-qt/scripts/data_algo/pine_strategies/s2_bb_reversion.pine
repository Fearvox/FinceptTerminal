//@version=6
strategy("S2_BB_MeanReversion", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.1)
length = 20
mult = 2.0
basis = ta.sma(close, length)
dev = mult * ta.stdev(close, length)
upper = basis + dev
lower = basis - dev
plot(basis, color=color.yellow)
plot(upper, color=color.red)
plot(lower, color=color.green)

rsi = ta.rsi(close, 14)

if close <= lower and rsi < 30
    strategy.entry("Long", strategy.long)
if close >= upper and rsi > 70
    strategy.close("Long")

if close >= upper and rsi > 70
    strategy.entry("Short", strategy.short)
if close <= lower and rsi < 30
    strategy.close("Short")
