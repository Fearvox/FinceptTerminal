# Supabase project settings. Use the service-role key only in Vercel/server env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# TradingView webhook guard. Use this as either ?secret=... or X-TV-Webhook-Secret.
TV_WEBHOOK_SECRET=replace-with-random-secret

# Dashboard Basic Auth. Required in production by proxy.ts.
DASHBOARD_USER=fincept
DASHBOARD_PASSWORD=replace-with-dashboard-password
