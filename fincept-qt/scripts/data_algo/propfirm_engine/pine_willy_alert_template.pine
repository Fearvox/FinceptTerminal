// ─────────────────────────────────────────────────────────────────────────
//  WillyAlgoTrader → FinceptTerminal propfirm-v4 webhook bridge
// ─────────────────────────────────────────────────────────────────────────
//  Paste this block into your WillyAlgoTrader Pine source, adapting the
//  variable names on the right-hand side to match your script.
//
//  Requirements:
//    • Pine v5+ (alert() supports dynamic strings; alertcondition() does not)
//    • TradingView Premium or higher (webhook alerts require Premium+)
//    • Set a TV alert whose condition is "Any alert() function call"
//      and whose webhook URL points at your local tv_webhook.py via a
//      cloudflared / ngrok tunnel. See README.tv_integration.md.
//
//  IMPORTANT: replace CHANGE_ME_SECRET with the same random string you
//  export as TV_WEBHOOK_SECRET when launching tv_webhook.py. Do NOT commit
//  your real secret into a public Pine snapshot.
// ─────────────────────────────────────────────────────────────────────────

// These are the variables your Willy script must expose at the alert point.
// Rename LHS only — RHS must match whatever your script uses internally.
longEntrySignal   = false      // e.g. longSignalA or tradeState == "Long A"
shortEntrySignal  = false      // e.g. shortSignalA
plannedEntryPrice = close      // typically close of signal bar
plannedStopLoss   = 0.0        // your SL level at entry time
plannedTakeProfit = 0.0        // your TP1 / R1 level; webhook logs only first TP
regimeLabel       = "unknown"  // Mixed/Norm Vol, Strong Trend, Range, ...
tqiValue          = na         // Trade Quality Index if exposed
qStrengthValue    = na         // Q.Strength component

// ─────────────── Long-side alert payload ────────────────
if longEntrySignal
    msg = '{"secret":"CHANGE_ME_SECRET","symbol":"' + syminfo.ticker +
       '","side":"long","entry":' + str.tostring(plannedEntryPrice, "#.#######") +
       ',"sl":' + str.tostring(plannedStopLoss,   "#.#######") +
       ',"tp":' + str.tostring(plannedTakeProfit, "#.#######") +
       ',"setup":"willy_long_a"' +
       ',"regime":"' + regimeLabel + '"' +
       ',"timeframe":"' + timeframe.period + '"' +
       ',"tqi":'        + str.tostring(tqiValue,      "#.##") +
       ',"q_strength":' + str.tostring(qStrengthValue, "#.##") +
       ',"ts_utc":"'    + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '"' +
       '}'
    alert(msg, alert.freq_once_per_bar_close)

// ─────────────── Short-side alert payload ───────────────
if shortEntrySignal
    msg = '{"secret":"CHANGE_ME_SECRET","symbol":"' + syminfo.ticker +
       '","side":"short","entry":' + str.tostring(plannedEntryPrice, "#.#######") +
       ',"sl":' + str.tostring(plannedStopLoss,   "#.#######") +
       ',"tp":' + str.tostring(plannedTakeProfit, "#.#######") +
       ',"setup":"willy_short_a"' +
       ',"regime":"' + regimeLabel + '"' +
       ',"timeframe":"' + timeframe.period + '"' +
       ',"tqi":'        + str.tostring(tqiValue,      "#.##") +
       ',"q_strength":' + str.tostring(qStrengthValue, "#.##") +
       ',"ts_utc":"'    + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '"' +
       '}'
    alert(msg, alert.freq_once_per_bar_close)
